# ============================================================================
# CONFIGURACIÓN BACKEND DJANGO - DEBANDI
# ============================================================================
# 1. Copia este archivo a .env
# 2. Completa con tus credenciales reales
# 3. NUNCA subas .env a Git
# ============================================================================

# ============================================================================
# DJANGO SETTINGS
# ============================================================================
DEBUG=True
SECRET_KEY=genera-tu-clave-con-get_random_secret_key
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================================================
# CORS / COOKIES
# ============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax

# ============================================================================
# EMAIL (Recuperación de Contraseña)
# ============================================================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USE_TLS=False
EMAIL_HOST_USER=tu-usuario
EMAIL_HOST_PASSWORD=tu-password
DEFAULT_FROM_EMAIL=noreply@debandi.com
FRONTEND_PASSWORD_RESET_URL=http://localhost:3000/reset-password

# ============================================================================
# MERCADO PAGO (https://mercadopago.com.ar/developers/panel)
# ============================================================================
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-xxxx
MERCADO_PAGO_PUBLIC_KEY=APP_USR-xxxx

# ============================================================================
# PRODUCCIÓN (cambiar estos valores al desplegar)
# ============================================================================
# DEBUG=False
# AUTH_COOKIE_SECURE=True
# ALLOWED_HOSTS=tudominio.com
# CORS_ALLOWED_ORIGINS=https://tudominio.com
# GOOGLE_REDIRECT_URI=https://tudominio.com/api/auth/google/callback/
# FRONTEND_PASSWORD_RESET_URL=https://tudominio.com/reset-password


