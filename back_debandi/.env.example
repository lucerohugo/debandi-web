# ============================================================================
# CONFIGURACIÓN BACKEND DJANGO - DEBANDI
# ============================================================================
# 1. Copia este archivo a .env
# 2. Completa con tus credenciales reales
# 3. NUNCA subas .env a Git
# ============================================================================

# ============================================================================
# DJANGO SETTINGS
# ============================================================================
DEBUG=True
SECRET_KEY=genera-tu-clave-con-get_random_secret_key
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================================================
# CORS / COOKIES
# ============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax

# ============================================================================
# JWT TOKENS - Duraciones en segundos
# ============================================================================
# ACCESS_TOKEN: Corta duración (recomendado: 900 seg = 15 min, desarrollo: 3600 = 1h)
# REFRESH_TOKEN: Larga duración (recomendado: 604800 = 7 días)
# Producción: ACCESS=900, REFRESH=604800 (7 días)
# Desarrollo: ACCESS=3600, REFRESH=2592000 (30 días)
ACCESS_TOKEN_LIFETIME_SECONDS=3600
REFRESH_TOKEN_LIFETIME_SECONDS=2592000

# ============================================================================
# API Key para scripts/integraciones externas
# ============================================================================
# Usar para autenticar requests desde scripts Python, integraciones, etc.
# Formato en header: Authorization: Api-Key <tu-api-key-aqui>
# Genera uno seguro: python -c "import secrets; print(secrets.token_hex(16))"
API_KEY=tu-api-key-segura-aqui


# ============================================================================
# EMAIL (Recuperación de Contraseña)
# ============================================================================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@debandi.com

# ============================================================================
# MERCADO PAGO (https://mercadopago.com.ar/developers/panel)
# ============================================================================
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-xxxx
MERCADO_PAGO_PUBLIC_KEY=APP_USR-xxxx

# ============================================================================
# PRODUCCIÓN (cambiar estos valores al desplegar)
# ============================================================================
# DEBUG=False
# AUTH_COOKIE_SECURE=True
# ALLOWED_HOSTS=tudominio.com
# CORS_ALLOWED_ORIGINS=https://tudominio.com
# ACCESS_TOKEN_LIFETIME_SECONDS=900
# REFRESH_TOKEN_LIFETIME_SECONDS=604800



